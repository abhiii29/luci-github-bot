# ── Required ────────────────────────────────────────────────────────────────
# GitHub PAT. Scopes: repo (+ admin:repo_hook if the bot should register webhooks itself).
# Do NOT grant `workflow`: the bot is never allowed to change CI files.
GITHUB_TOKEN=ghp_your_token_here
# HMAC secret shared with the GitHub webhook (min. 16 characters)
WEBHOOK_SECRET=change_me_to_a_long_random_string
# Comma-separated owner/repo list
MONITORED_REPOS=your-user/your-repo
# Login of the bot account (default: owner of the first monitored repo)
GITHUB_BOT_USERNAME=

# ── Remote model (default pipeline) ────────────────────────────────────────
ADASSO_BASE_URL=https://adesso-ai-hub.3asabc.de/v1
ADASSO_API_KEY_FILE=~/.config/opencode/adesso.key
ADASSO_MODEL=qwen-3.6-35b-sovereign

# ── Local model (bot:local label, model=local, @local-model) ────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_DECOMPOSITION_TIMEOUT_MS=300000
OLLAMA_SUBTASK_TIMEOUT_MS=300000

# ── Server ──────────────────────────────────────────────────────────────────
LISTEN_PORT=3000
# ngrok tunnel + automatic webhook registration (leave empty to set up the webhook yourself)
NGROK_AUTHTOKEN=
# Bearer token for /api/*; empty = /api/* only answers direct local requests
API_TOKEN=
WEBHOOK_BODY_LIMIT=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SHUTDOWN_TIMEOUT_MS=30000
LOG_LEVEL=info

# ── Workers ─────────────────────────────────────────────────────────────────
CONTAINER_RUNTIME=podman
MAX_CONCURRENT_WORKERS=1
WORKER_TIMEOUT_MS=600000
# Optional container limits, e.g. 1g / 1.5 / 256
CONTAINER_MEMORY=
CONTAINER_CPUS=
CONTAINER_PIDS_LIMIT=
# Host load (%) above which worker slots shrink
MEMORY_PRESSURE_MAX=85
CPU_MAX=90
RESOURCE_CHECK_INTERVAL_MS=10000
GIT_AUTHOR_NAME=luci-github-bot
GIT_AUTHOR_EMAIL=luci-github-bot@users.noreply.github.com

# ── Behaviour ───────────────────────────────────────────────────────────────
# 1 = never push anything, just report what would happen
DRY_RUN=
PLAN_DATA_DIR=.luci-bot-plans
