# GitHub Personal Access Token (scopes: repo, workflow)
GITHUB_TOKEN=ghp_your_token_here

# Adesso AI Hub configuration
ADASSO_BASE_URL=https://adesso-ai-hub.3asabc.de/v1
ADASSO_API_KEY_FILE=~/.config/opencode/adesso.key
ADASSO_MODEL=qwen-3.6-35b-sovereign

# Ngrok auth token (get from https://dashboard.ngrok.com/get-started/authtokens)
NGROK_AUTHTOKEN=your_ngrok_token_here

# Server configuration
LISTEN_PORT=3000
WEBHOOK_SECRET=your_webhook_secret_here_min_16_chars

# Monitored repositories (comma-separated owner/repo format)
MONITORED_REPOS=luci/luci-bot

# Container runtime: podman (faster, no daemon) or docker
CONTAINER_RUNTIME=podman

# Resource monitoring — worker slots scale based on available CPU/memory
MEMORY_PRESSURE_MAX=85
CPU_MAX=90
RESOURCE_CHECK_INTERVAL_MS=10000

# Worker configuration
WORKER_TIMEOUT_MS=600000
MAX_CONCURRENT_WORKERS=3

# Git identity for PR creation
GIT_AUTHOR_NAME=luci-github-bot
GIT_AUTHOR_EMAIL=luci-github-bot@users.noreply.github.com

# Bot username (auto-detected from repos if not set)
GITHUB_BOT_USERNAME=

# API token for /api/* endpoints (leave empty to bind to localhost only)
API_TOKEN=

# Webhook hardening
WEBHOOK_BODY_LIMIT=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Graceful shutdown timeout (milliseconds)
SHUTDOWN_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info

# Local model (Ollama) configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_DECOMPOSITION_TIMEOUT_MS=300000
OLLAMA_SUBTASK_TIMEOUT_MS=300000
